<!DOCTYPE html>
<html>
<head>
<title>Chat Ivoire</title>
<style>
body { font-family: Arial; background: #e5ddd5; margin:0; display:flex; justify-content:center; }
.container { width:400px; height:90vh; background:white; margin-top:20px; display:flex; flex-direction:column; border-radius:10px; overflow:hidden; }
.header { background:#075E54; color:white; padding:15px; text-align:center; font-weight:bold; }
.chat-box { flex:1; overflow-y:auto; padding:15px; background:#ece5dd; }
.message { background:white; padding:10px; margin:8px 0; border-radius:8px; max-width:70%; }
.moi { background:#dcf8c6; margin-left:auto; }
.input-zone { display:flex; padding:10px; background:#f0f0f0; gap:5px; }
input { flex:1; padding:12px; border:none; border-radius:20px; outline:none; }
button { background:#128C7E; color:white; border:none; padding:10px 20px; border-radius:20px; cursor:pointer; }
</style>
</head>
<body>
<div class="container">
<div class="header">🇨🇮 Chat Ivoire</div>
<div class="chat-box" id="chat"></div>
<div class="input-zone">
<input type="text" id="nom" placeholder="Ton pseudo">
<input type="text" id="msg" placeholder="Écris un message...">
<button onclick="envoyer()">Envoyer</button>
</div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js";
import { getFirestore, collection, addDoc, query, orderBy, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore.js";

// COLLE TA CONFIG FIREBASE ICI - Va dans Paramètres projet > SDK
const firebaseConfig = {
  apiKey: "AIzaSyC-FIDt2IB-HzyDKwOEIbUt5sTB8mdFKM",
  authDomain: "chat-ivoire.firebaseapp.com",
  projectId: "chat-ivoire",
  storageBucket: "chat-ivoire.firebasestorage.app",
  messagingSenderId: "598586912655",
  appId: "1:598586912655:web:fd973fd69898a2246e65fa"
};
  
  
  
  
  
  


const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

window.envoyer = async function() {
  let nom = document.getElementById('nom').value.trim();
  let msg = document.getElementById('msg').value.trim();
  if(nom == "" || msg == "") { alert("Faut mettre un nom et un message bro !"); return; }
  await addDoc(collection(db, "messages"), { pseudo: nom, texte: msg, date: serverTimestamp() });
  document.getElementById('msg').value = "";
}

const q = query(collection(db, "messages"), orderBy("date"));
onSnapshot(q, (snapshot) => {
  let chat = document.getElementById('chat');
  chat.innerHTML = "";
  snapshot.forEach((doc) => {
    let data = doc.data();
    let div = document.createElement('div');
    div.className = 'message moi';
    div.innerHTML = `<b>${data.pseudo}:</b> ${data.texte}`;
    chat.appendChild(div);
  });
  chat.scrollTop = chat.scrollHeight;
});

document.getElementById('msg').addEventListener('keypress', (e) => { if(e.key === 'Enter') envoyer(); });
</script>
</body>
</html>